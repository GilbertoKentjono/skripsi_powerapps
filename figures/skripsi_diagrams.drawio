            <mxPoint x="345" y="180" as="sourcePoint" />
            <mxPoint x="575" y="180" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m3" edge="1" parent="1" style="html=1;endArrow=block;fontSize=13;align=left;" value="3. Set varStatus = RUNNING; Set varStart = Now()">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="655" y="215" />
              <mxPoint x="655" y="250" />
            </Array>
            <mxPoint x="575" y="215" as="sourcePoint" />
            <mxPoint x="575" y="250" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m4" edge="1" parent="1" style="html=1;endArrow=block;fontSize=13;" value="4. Kirim query&#xa;S1: Filter() + Sort(Seq) - delegable penuh&#xa;S2: Not(IsBlank()) - tidak delegable">

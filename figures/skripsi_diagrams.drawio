          </mxGeometry>
        </mxCell>
        <mxCell id="m6" edge="1" parent="1" style="html=1;endArrow=block;fontSize=13;align=left;" value="6. ClearCollect ke colResult;&#xa;Set varStatus = DONE | pola | param | rows | ms&#xa;(ms = DateDiff varStart sampai Now)">

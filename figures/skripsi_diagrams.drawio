            <mxPoint as="offset" />
            <mxPoint x="575" y="510" as="sourcePoint" />
            <mxPoint x="345" y="510" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m8" edge="1" parent="1" style="html=1;endArrow=block;dashed=1;fontSize=13;" value="8. Polling: baca lblStatus sampai status cocok&#xa;dengan pola dan parameter yang sedang dijalankan">

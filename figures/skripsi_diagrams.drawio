              <mxPoint x="160" y="600" />
              <mxPoint x="160" y="635" />
            </Array>
            <mxPoint x="80" y="600" as="sourcePoint" />
            <mxPoint x="80" y="635" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="n1" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;" value="Pengukuran round-trip: dimulai saat Set(varStart) pada langkah 3&#xa;dan berakhir saat DateDiff pada langkah 6. Mencakup overhead konektor&#xa;dan latensi jaringan, tidak mencakup rendering Gallery control." vertex="1">
          <mxGeometry height="95" width="350" x="950" y="410" as="geometry" />
        </mxCell>
        <mxCell id="n2" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;align=left;" value="S2 menghasilkan silent data truncation:&#xa;pada skala 5k hanya 395 dari 984 baris yang cocok filter&#xa;diperoleh, tanpa pesan kesalahan kepada pengguna." vertex="1">
          <mxGeometry height="70" width="340" x="950" y="325" as="geometry" />
        </mxCell>
        <mxCell id="n3" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#f5f5f5;strokeColor=#999999;fontSize=13;align=left;dashed=1;" value="Query Store pada Azure SQL tetap aktif&#xa;sebagai data pendukung, bukan dasar komparasi&#xa;antar sumber data." vertex="1">
          <mxGeometry height="60" width="300" x="40" y="670" as="geometry" />
